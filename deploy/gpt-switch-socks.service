[Unit]
Description=gpt-Switch authenticated SOCKS5
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/danted -f /etc/gpt-switch-socks/danted.conf -p /run/gpt-switch-socks/danted.pid
Restart=on-failure
RestartSec=3
UMask=0077
RuntimeDirectory=gpt-switch-socks
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
